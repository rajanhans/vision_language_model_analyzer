# Copy this file to .env and add the keys for the providers you intend to use.
# Never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Provider-specific model defaults. The UI also accepts a custom model ID.
VLM_OPENAI_MODEL=gpt-5.6
VLM_GEMINI_MODEL=gemini-3.1-pro-preview
VLM_GEMINI_THINKING_LEVEL=high
VLM_GEMINI_PROCESSING_TIMEOUT_SECONDS=300

# Backward-compatible OpenAI default.
VLM_MODEL=gpt-5.6
VLM_MAX_TOOL_ROUNDS=4
VLM_MAX_IMAGE_MB=10
VLM_MAX_IMAGE_MEGAPIXELS=20
VLM_MAX_IMAGE_DIMENSION=8000

# Optional video-extension settings.
VLM_VIDEO_FRAMES=12
VLM_MAX_VIDEO_MB=100
VLM_MAX_VIDEO_SECONDS=60
VLM_MAX_VIDEO_WIDTH=3840
VLM_MAX_VIDEO_HEIGHT=2160
VLM_VIDEO_FRAME_WIDTH=1920
VLM_VIDEO_FRAME_HEIGHT=1080

# UI and server limits.
VLM_PREVIEW_WIDTH=480
VLM_PREVIEW_HEIGHT=360
VLM_MAX_CONCURRENT_ANALYSES=4
